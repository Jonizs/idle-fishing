{
  "name": "idle-fishing-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create idle-fishing",
    "db:init": "wrangler d1 execute idle-fishing --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute idle-fishing --local --file=schema.sql",
    "db:backup": "wrangler d1 export idle-fishing --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
